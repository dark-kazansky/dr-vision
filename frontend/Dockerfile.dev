# ═══════════════════════════════════════════════════════════════════════════════
# Doc Intelligence Frontend — Development Dockerfile
# Hot-reload via nuxt dev. Code mounted as volume.
# ═══════════════════════════════════════════════════════════════════════════════

FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

ENV HOST=0.0.0.0 \
    NUXT_HOST=0.0.0.0 \
    NUXT_PORT=3000

EXPOSE 3000

# Code is volume-mounted via docker-compose
CMD ["npm", "run", "dev"]

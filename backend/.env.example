# ═══════════════════════════════════════════════════════════════════════════════
# Doc Intelligence Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For dev: use docker compose up -d postgres minio, then use the defaults below.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://drvision:drvision_dev@localhost:5433/drvision

# ─── MinIO Storage (REQUIRED) ────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=drvision-docs

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
FASTAPI_DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate secret with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256

# Admin user auto-created on first boot (if no users exist in DB)
ADMIN_EMAIL=admin@drvision.com
ADMIN_PASSWORD=admin123

# ─── AI Providers (fill in as needed) ────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234
OLLAMA_BASE_URL=http://localhost:11434
GOOGLE_STUDIO_API_KEY=
POE_API_KEY=
BEDROCK_REGION=ap-southeast-2
CLAUDE_HAIKU_ID=
CLAUDE_SONET_ID=

# ─── Upload ──────────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=10

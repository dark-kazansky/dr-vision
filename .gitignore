# ═══════════════════════════════════════════════════════════════════════════════
# Dr.Vision — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.conda/

# ─── Testing & Quality ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
.ruff_cache/

# ─── IDEs & Editors ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.kiro/

# ─── Environment Variables (secrets) ─────────────────────────────────────────
.env
.env.local
.env.prod
.env.staging
.env.*.local
!.env.example
!backend/.env.example
!frontend/.env.example

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp

# ─── Backend: Runtime Data ────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/uploaded/*
!backend/data/uploaded/.gitkeep

# ─── AI Model Files (downloaded at runtime) ──────────────────────────────────
backend/models/
*.onnx
*.pt
*.pth
*.bin
*.h5
*.pkl
*.safetensors

# ─── Frontend: Build Artifacts ────────────────────────────────────────────────
frontend/.nuxt/
frontend/.output/
frontend/node_modules/

# ─── Local Data (never tracked) ──────────────────────────────────────────────
data/
dataResult/

# ─── Notebooks & Experiments ──────────────────────────────────────────────────
*.ipynb
notebooks/
experiments/

# ─── Logs & Artifacts ─────────────────────────────────────────────────────────
*.log
artifacts/logs/*
!artifacts/logs/.gitkeep
artifacts/screenshots/*
!artifacts/screenshots/.gitkeep

# ─── Build & Deploy Artifacts ─────────────────────────────────────────────────
*.tar.gz
*.zip
.dev-server.pid

# ═══════════════════════════════════════════════════════════════════════════════
# Dr.Vision — .gitignore (Monorepo: services/ + backend/ + frontend/)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.conda/

# ─── Testing & Quality ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
.ruff_cache/

# ─── IDEs & Editors ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.kiro/

# ─── Environment Variables (secrets) ─────────────────────────────────────────
.env
.env.local
.env.prod
.env.staging
.env.*.local

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp

# ─── Backend: Runtime Data ────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/uploaded/*
!backend/data/uploaded/.gitkeep
backend/data/classified/*
!backend/data/classified/.gitkeep
backend/data/extracted/*
!backend/data/extracted/.gitkeep
backend/data/parsed/*
!backend/data/parsed/.gitkeep
backend/data/raw_ocr/*
!backend/data/raw_ocr/.gitkeep
backend/data/splited/*
!backend/data/splited/.gitkeep

# ─── Frontend: Build Artifacts ────────────────────────────────────────────────
frontend/.nuxt/
frontend/.output/
frontend/node_modules/

# ─── Data & Results (local testing) ──────────────────────────────────────────
dataResult/
data/

# ─── Notebooks & Experiments ──────────────────────────────────────────────────
*.ipynb
notebooks/
experiments/

# ─── Logs & Artifacts ─────────────────────────────────────────────────────────
*.log
artifacts/logs/*.log
artifacts/screenshots/*.png

# ─── Build & Deploy Artifacts ─────────────────────────────────────────────────
*.tar.gz
*.zip
.dev-server.pid

# ─── Services: Runtime ────────────────────────────────────────────────────────
services/*/uploads/
services/*/.venv/
services/*/uv.lock

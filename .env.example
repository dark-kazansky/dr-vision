# ═══════════════════════════════════════════════════════════════════════════════
# Doc Intelligence — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real credentials to version control.
#
# For production: copy to .env.prod and use with docker-compose.prod.yml
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=drvision
POSTGRES_USER=drvision
POSTGRES_PASSWORD=            # REQUIRED: Set a strong password
POSTGRES_PORT=5433            # Host port mapped to container's 5432

# Full connection string (used by backend)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── MinIO (Object Storage) ──────────────────────────────────────────────────
MINIO_ROOT_USER=              # REQUIRED: MinIO admin username
MINIO_ROOT_PASSWORD=          # REQUIRED: MinIO admin password (min 8 chars)
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=drvision-docs

# These should match MINIO_ROOT_USER/PASSWORD for default setup
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# ─── Backend Server ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
FASTAPI_DEBUG=false

# CORS: comma-separated list of allowed origins
# Dev: http://localhost:3000
# Prod: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ─── Authentication (REQUIRED for production) ────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# First admin user (auto-created on first boot if no users exist)
ADMIN_EMAIL=admin@drvision.com
ADMIN_PASSWORD=              # REQUIRED: Set a strong password for admin

# ─── AI Providers (optional — enable as needed) ──────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini
GOOGLE_STUDIO_API_KEY=

# AWS Bedrock
BEDROCK_REGION=ap-southeast-2
CLAUDE_HAIKU_ID=
CLAUDE_SONET_ID=

# POE
POE_API_KEY=

# ─── Upload Settings ─────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=10

# ─── Frontend ────────────────────────────────────────────────────────────────
# API URL the frontend uses to reach the backend
API_BASE_URL=http://localhost:8000

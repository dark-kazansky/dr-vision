# M.DocAI MSBE — local development env
# Copy to .env and edit to suit. Docker compose reads from this file too.

GATEWAY_PORT=8090
AUTH_SERVICE_URL=http://localhost:8006
ORCHESTRATOR_SERVICE_URL=http://localhost:8091
PARSER_SERVICE_URL=http://localhost:8001
CLASSIFIER_SERVICE_URL=http://localhost:8002
EXTRACTOR_SERVICE_URL=http://localhost:8003
SPLITTER_SERVICE_URL=http://localhost:8004
SCHEMA_GENERATOR_SERVICE_URL=http://localhost:8005

MSBE_DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000

# Auth service
JWT_SECRET_KEY=mdocai-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# API keys are read by worker services that need them. Match what
# `ms-backend/.env.example` expects so existing keys keep working.
POE_API_KEY=
GOOGLE_STUDIO_API_KEY=
